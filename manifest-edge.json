{
  "manifest_version": 3,
  "name": "Colloqui Facili",
  "author": "Leo971",
  "version": "1.4.1",
  "description": "Crea colloqui settimanali e assegna i link alle prenotazioni su ClasseViva, con anteprima e verifica. Strumento indipendente.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Colloqui Facili",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.spaggiari.eu/cvv/app/default/gioprof_colloqui.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "help.html"
      ],
      "matches": [
        "https://web.spaggiari.eu/*"
      ]
    }
  ],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "109"
}
